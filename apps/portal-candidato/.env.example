# Copie para .env.local. As duas primeiras são públicas (a proteção é o RLS no banco).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secreta — servidor apenas (usada em src/lib/openai.ts, nunca importada em componente "use client").
# Extração de documentos anexados (painel da Comissão). Sem esta chave, o botão "Analisar com IA" falha.
OPENAI_API_KEY=
# Opcional: nome do modelo (Responses API, com suporte a PDF/imagem). Padrão: gpt-4o-mini.
OPENAI_EXTRACTION_MODEL=

# Secretas — servidor apenas (src/lib/email.ts). E-mails enviados pelo app: convite para o painel e convite para a
# entrevista técnica. Podem ser as mesmas credenciais do SMTP configurado no Supabase Auth. Sem elas, o painel mostra o
# texto para a Comissão enviar por outro meio (o convite da entrevista aparece no portal do candidato de qualquer forma).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
